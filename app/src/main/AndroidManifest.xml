<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ACL_CONNECTED 广播里读取 BluetoothDevice（Android 12+ 运行时权限，Onboarding 首次进入时申请） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 结果通知（Android 13+ 运行时权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 电池白名单引导（Onboarding「加入电池白名单」，需显式声明才能发 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 前台服务（FGS 主触发载体，OriginOS 7 禁广播冷启动后的唯一可靠触发路径） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 开机拉起 ListenerService -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 包可见性：真机实测缺它导致 Shizuku/Stellar 安装探测误报 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api"/>
        <package android:name="roro.stellar.manager"/>
    </queries>

    <application
        android:name=".StayHiFiApp"
        android:label="StayHiFi"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 连接触发自动拉满（设计 §4.3，goAsync 短任务零驻留）。
             发送方是蓝牙栈（com.android.bluetooth，uid 1002，非 system_server）：
             Android 13+ 下 exported=false 收不到非 system uid 进程的广播（真机实证），
             必须 exported=true；用 BLUETOOTH_CONNECT 权限做防护（蓝牙栈持有，普通 App 没有）。 -->
        <receiver
            android:name=".trigger.ConnectionReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- 开机拉起 FGS（OriginOS 需自启动权限才收得到，Onboarding 保活页已引导） -->
        <receiver android:name=".trigger.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- FGS 主触发载体：运行时注册 ACL_CONNECTED，常驻静默通知 -->
        <service
            android:name=".trigger.ListenerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 快捷设置磁贴：一键拉满 -->
        <service
            android:name=".notify.QsTileService"
            android:label="StayHiFi"
            android:icon="@drawable/ic_qs_tile"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shizuku 拉起的特权 UserService（独立进程 :codec，身份 adb shell）；
             Instantiatable：Shizuku UserService 由 Shizuku 进程反射实例化，非系统 Service 组件 -->
        <service
            android:name=".shell.CodecService"
            android:exported="false"
            android:process=":codec"
            tools:ignore="Instantiatable" />

        <!-- Shizuku binder 接收器（必须手动声明，provider 工件不会自动合并） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
