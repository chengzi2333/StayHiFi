<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ACL_CONNECTED 广播里读取 BluetoothDevice（Android 12+ 运行时权限，Onboarding 首次进入时申请） -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 结果通知（Android 13+ 运行时权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 电池白名单引导（Onboarding「加入电池白名单」，需显式声明才能发 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 包可见性：真机实测缺它导致 Shizuku/Stellar 安装探测误报 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api"/>
        <package android:name="roro.stellar.manager"/>
    </queries>

    <application
        android:label="音质满格"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 连接触发自动拉满（设计 §4.3，goAsync 短任务零驻留） -->
        <receiver android:name=".trigger.ConnectionReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku 拉起的特权 UserService（独立进程 :codec，身份 adb shell） -->
        <service
            android:name=".shell.CodecService"
            android:exported="false"
            android:process=":codec" />

        <!-- Shizuku binder 接收器（必须手动声明，provider 工件不会自动合并） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
